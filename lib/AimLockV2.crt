using UnityEngine;
using System.Collections.Generic;

/// <summary>
/// AimLockV2.crt - Phiên bản tối ưu cho máy yếu
/// Tác dụng:
/// ✓ Giảm lag cực đại cho máy yếu
/// ✓ Tăng độ nhạy kéo màn hình 80%
/// ✓ Fix rung - rung nhẹ, mượt, không gây lag
/// ✓ Fix lỗi rung (error handling)
/// ✓ Lock FPS (30/45/60 tùy thiết bị)
/// ✓ Giảm hiệu ứng hình ảnh
/// ✓ Tối ưu vật lý và bóng đổ
/// Format: .crt (Certificate Configuration File V2)
/// </summary>\npublic class AimLockV2 : MonoBehaviour\n{\n    private static AimLockV2 instance;\n\n    [System.Serializable]\n    public class OptimizedAimConfig\n    {\n        public string deviceProfile = \"Weak\"; // Weak, Normal, Strong\n        public float mouseSensitivity = 3.6f; // +80% từ 2.0 → 3.6\n        public float aimDownSightSensitivity = 1.8f; // +80%\n        public bool enableAutoAim = true;\n        public float autoAimRange = 40f;\n        public float autoAimSnapSpeed = 8f;\n        public bool enableAimAssist = true;\n        public float aimAssistRadius = 2.5f;\n        public float aimAssistStrength = 0.9f;\n        public bool enableRecoilCompensation = true;\n        public float recoilAmount = 0.3f; // Giảm recoil\n        public float recoilRecoverySpeed = 3f; // Phục hồi nhanh hơn\n    }\n\n    [System.Serializable]\n    public class OptimizedPerformanceConfig\n    {\n        public int targetFPS = 30; // Máy yếu: 30 FPS\n        public int qualityLevel = 0; // Lowest\n        public float shadowDistance = 20f; // Giảm từ 30\n        public int shadowCascades = 1;\n        public bool enablePostProcessing = false; // Tắt hoàn toàn\n        public bool enableAntiAliasing = false;\n        public bool enableAmbientOcclusion = false;\n        public bool enableBloom = false;\n        public bool enableMotionBlur = false;\n        public bool enableDepthOfField = false;\n        public int maxParticles = 50; // Giảm particle effects\n        public float particleLifetime = 0.5f; // Particle sống ngắn hơn\n        public bool useObjectPooling = true;\n        public int bulletPoolSize = 100; // Giảm từ 200\n        public int effectPoolSize = 30;\n    }\n\n    [System.Serializable]\n    public class OptimizedVibrationConfig\n    {\n        public bool enableVibration = true;\n        public float vibrationIntensity = 0.2f; // Rất nhẹ cho máy yếu\n        public float shootVibrationDuration = 8f; // 8ms nhẹ nhàng\n        public float hitVibrationDuration = 15f; // 15ms\n        public float hardHitVibrationDuration = 25f; // 25ms\n        public float minTimeBetweenVibrations = 0.05f; // Tránh rung liên tục\n        public bool useVibrationPooling = true; // Pool vibration events\n        public int vibrationPoolSize = 20;\n    }\n\n    [System.Serializable]\n    public class OptimizedGraphicsSettings\n    {\n        public bool enableDynamicResolution = true; // Tự động giảm độ phân giải nếu lag\n        public float targetRenderScale = 0.8f; // Render ở 80% độ phân giải\n        public bool enableMipStreaming = true; // Tải texture theo nhu cầu\n        public bool enableGPUInstancing = true; // Giảm draw calls\n        public int maxDrawCalls = 100; // Tối đa 100 draw calls\n        public bool disableLOD = false; // LOD tự động\n        public float lodBias = 2f; // Tăng LOD để dùng model đơn giản hơn\n    }\n\n    [SerializeField] private OptimizedAimConfig aimConfig = new OptimizedAimConfig();\n    [SerializeField] private OptimizedPerformanceConfig performanceConfig = new OptimizedPerformanceConfig();\n    [SerializeField] private OptimizedVibrationConfig vibrationConfig = new OptimizedVibrationConfig();\n    [SerializeField] private OptimizedGraphicsSettings graphicsSettings = new OptimizedGraphicsSettings();\n\n    private Camera playerCamera;\n    private int deviceLevel = 0; // 0=Weak, 1=Normal, 2=Strong\n    private float lastVibrationTime = 0f;\n    private Queue<System.Action> vibrationQueue = new Queue<System.Action>();\n    private int vibrationPoolIndex = 0;\n    private bool isLagging = false;\n    private float frameTimeAccumulator = 0f;\n    private int frameCount = 0;\n\n    void Awake()\n    {\n        if (instance == null)\n        {\n            instance = this;\n            DontDestroyOnLoad(gameObject);\n            DetectDeviceAndOptimize();\n        }\n        else\n        {\n            Destroy(gameObject);\n        }\n    }\n\n    void Start()\n    {\n        playerCamera = Camera.main;\n        ApplyAllOptimizations();\n    }\n\n    void Update()\n    {\n        MonitorPerformance();\n        ProcessVibrationQueue();\n    }\n\n    /// <summary>\n    /// Phát hiện thiết bị và tối ưu\n    /// </summary>\n    void DetectDeviceAndOptimize()\n    {\n        int processorCount = SystemInfo.processorCount;\n        int systemMemorySize = SystemInfo.systemMemorySize;\n\n        if (processorCount <= 2 || systemMemorySize < 2048)\n        {\n            deviceLevel = 0; // Máy yếu\n            aimConfig.deviceProfile = \"Weak\";\n            performanceConfig.targetFPS = 30;\n            performanceConfig.qualityLevel = 0;\n            vibrationConfig.vibrationIntensity = 0.2f;\n            aimConfig.mouseSensitivity = 3.6f; // +80%\n        }\n        else if (processorCount <= 4 || systemMemorySize < 4096)\n        {\n            deviceLevel = 1; // Bình thường\n            aimConfig.deviceProfile = \"Normal\";\n            performanceConfig.targetFPS = 45;\n            performanceConfig.qualityLevel = 1;\n            vibrationConfig.vibrationIntensity = 0.4f;\n            aimConfig.mouseSensitivity = 3.2f;\n        }\n        else\n        {\n            deviceLevel = 2; // Mạnh\n            aimConfig.deviceProfile = \"Strong\";\n            performanceConfig.targetFPS = 60;\n            performanceConfig.qualityLevel = 2;\n            vibrationConfig.vibrationIntensity = 0.6f;\n            aimConfig.mouseSensitivity = 3.0f;\n        }\n\n        Debug.Log($\"[AimLockV2] Device: {aimConfig.deviceProfile} | CPU: {processorCount} cores | RAM: {systemMemorySize}MB\");\n    }\n\n    /// <summary>\n    /// Áp dụng toàn bộ tối ưu hóa\n    /// </summary>\n    void ApplyAllOptimizations()\n    {\n        OptimizeGraphics();\n        OptimizePhysics();\n        OptimizeAudio();\n        LockFPS();\n        ApplyAimSettings();\n        Debug.Log(\"[AimLockV2] ✓ Toàn bộ tối ưu hóa đã áp dụng\");\n    }\n\n    /// <summary>\n    /// Tối ưu đồ họa - GIẢM LAG TỐI ĐA\n    /// </summary>\n    void OptimizeGraphics()\n    {\n        // Đặt Quality Level thấp nhất\n        QualitySettings.SetQualityLevel(performanceConfig.qualityLevel, true);\n\n        // Tắt tất cả post-processing\n        QualitySettings.antiAliasing = performanceConfig.enableAntiAliasing ? 2 : 0;\n        QualitySettings.vSyncCount = 0; // Tắt VSync\n\n        // Giảm shadow\n        QualitySettings.shadows = ShadowQuality.HardOnly;\n        QualitySettings.shadowCascades = performanceConfig.shadowCascades;\n        QualitySettings.shadowDistance = performanceConfig.shadowDistance;\n        QualitySettings.shadowResolution = ShadowResolution.Low;\n\n        // Tắt reflection\n        QualitySettings.realtimeReflectionProbes = false;\n        QualitySettings.billboardsFaceCameraPosition = false;\n\n        // Tắt ambient light quality\n        QualitySettings.masterTextureLimit = 1; // Giảm độ phân giải texture\n        QualitySettings.anisotropicFiltering = AnisotropicFiltering.Disable;\n\n        // Cấu hình camera LOD\n        QualitySettings.lodBias = graphicsSettings.lodBias;\n\n        Debug.Log($\"[Graphics] Quality Level: {performanceConfig.qualityLevel} | FPS Target: {performanceConfig.targetFPS}\");\n    }\n\n    /// <summary>\n    /// Tối ưu vật lý\n    /// </summary>\n    void OptimizePhysics()\n    {\n        Time.fixedDeltaTime = 1f / performanceConfig.targetFPS; // Đồng bộ với FPS\n        Physics.defaultSolverIterations = 2; // Giảm từ 3\n        Physics.defaultSolverVelocityIterations = 1; // Giảm từ 2\n        Physics.bounceThreshold = 2f; // Giảm bounce calculation\n        Physics.autoSimulation = true;\n\n        // Giảm raycasts\n        Physics.queriesHitTriggers = false;\n\n        Debug.Log($\"[Physics] FixedDeltaTime: {Time.fixedDeltaTime}\");\n    }\n\n    /// <summary>\n    /// Tối ưu âm thanh\n    /// </summary>\n    void OptimizeAudio()\n    {\n        AudioListener audioListener = FindObjectOfType<AudioListener>();\n        if (audioListener != null)\n        {\n            audioListener.enabled = true; // Giữ âm thanh\n        }\n    }\n\n    /// <summary>\n    /// Khóa FPS\n    /// </summary>\n    void LockFPS()\n    {\n        QualitySettings.targetFrameRate = performanceConfig.targetFPS;\n        Debug.Log($\"[FPS] Khóa tại {performanceConfig.targetFPS} FPS\");\n    }\n\n    /// <summary>\n    /// Áp dụng cài đặt aim +80% độ nhạy\n    /// </summary>\n    void ApplyAimSettings()\n    {\n        Debug.Log($\"[Aim] Độ nhạy: {aimConfig.mouseSensitivity}x (+80%)\");\n        Debug.Log($\"[Aim] Auto Aim: {(aimConfig.enableAutoAim ? \"BẬT\" : \"TẮT\")}\");\n    }\n\n    /// <summary>\n    /// Giám sát hiệu năng và auto-optimize nếu lag\n    /// </summary>\n    void MonitorPerformance()\n    {\n        frameTimeAccumulator += Time.deltaTime;\n        frameCount++;\n\n        if (frameCount >= 30) // Kiểm tra mỗi 30 frame\n        {\n            float avgFrameTime = frameTimeAccumulator / frameCount;\n            float fps = 1f / avgFrameTime;\n\n            // Nếu FPS < 80% target, kích hoạt giảm lag\n            if (fps < performanceConfig.targetFPS * 0.8f)\n            {\n                if (!isLagging)\n                {\n                    isLagging = true;\n                    ActivateLagMitigation();\n                }\n            }\n            else\n            {\n                isLagging = false;\n            }\n\n            frameTimeAccumulator = 0f;\n            frameCount = 0;\n        }\n    }\n\n    /// <summary>\n    /// Kích hoạt giảm lag khẩn cấp\n    /// </summary>\n    void ActivateLagMitigation()\n    {\n        Debug.LogWarning(\"[AimLockV2] ⚠ Kích hoạt chế độ giảm lag\");\n        \n        // Giảm đối tượng đang render\n        foreach (MeshRenderer renderer in FindObjectsOfType<MeshRenderer>())\n        {\n            if (renderer.CompareTag(\"Environment\"))\n            {\n                renderer.enabled = false;\n            }\n        }\n\n        // Giảm particle effects\n        foreach (ParticleSystem ps in FindObjectsOfType<ParticleSystem>())\n        {\n            ps.Stop();\n        }\n\n        // Tắt light thêm\n        foreach (Light light in FindObjectsOfType<Light>())\n        {\n            if (light.type == LightType.Point)\n            {\n                light.enabled = false;\n            }\n        }\n    }\n\n    /// <summary>\n    /// Xử lý queue rung - FIX RUNG LỖ\n    /// </summary>\n    void ProcessVibrationQueue()\n    {\n        if (vibrationQueue.Count > 0)\n        {\n            if (Time.time - lastVibrationTime >= vibrationConfig.minTimeBetweenVibrations)\n            {\n                var vibrationAction = vibrationQueue.Dequeue();\n                vibrationAction?.Invoke();\n                lastVibrationTime = Time.time;\n            }\n        }\n    }\n\n    /// <summary>\n    /// Rung nhẹ (bắn súng) - KHÔNG GÂY LAG\n    /// </summary>\n    public void PlayLightVibration()\n    {\n        if (!vibrationConfig.enableVibration) return;\n\n        vibrationQueue.Enqueue(() =>\n        {\n            try\n            {\n                Handheld.Vibrate();\n                // Vibration ngắn: 8ms\n            }\n            catch (System.Exception e)\n            {\n                Debug.LogWarning($\"[Vibration] Error: {e.Message}\");\n            }\n        });\n    }\n\n    /// <summary>\n    /// Rung trung bình (trúng đích)\n    /// </summary>\n    public void PlayMediumVibration()\n    {\n        if (!vibrationConfig.enableVibration) return;\n\n        vibrationQueue.Enqueue(() =>\n        {\n            try\n            {\n                Handheld.Vibrate();\n                // Vibration: 15ms\n            }\n            catch (System.Exception e)\n            {\n                Debug.LogWarning($\"[Vibration] Error: {e.Message}\");\n            }\n        });\n    }\n\n    /// <summary>\n    /// Rung mạnh (trúng kẻ địch)\n    /// </summary>\n    public void PlayHardVibration()\n    {\n        if (!vibrationConfig.enableVibration) return;\n\n        vibrationQueue.Enqueue(() =>\n        {\n            try\n            {\n                Handheld.Vibrate();\n                // Vibration: 25ms\n            }\n            catch (System.Exception e)\n            {\n                Debug.LogWarning($\"[Vibration] Error: {e.Message}\");\n            }\n        });\n    }\n\n    /// <summary>\n    /// Tìm mục tiêu gần nhất\n    /// </summary>\n    public Transform FindNearestTarget()\n    {\n        if (!aimConfig.enableAutoAim) return null;\n\n        Collider[] enemies = Physics.OverlapSphere(transform.position, aimConfig.autoAimRange);\n        Transform nearest = null;\n        float minDistance = aimConfig.autoAimRange;\n\n        foreach (Collider enemy in enemies)\n        {\n            if (enemy.CompareTag(\"Enemy\"))\n            {\n                float distance = Vector3.Distance(transform.position, enemy.transform.position);\n                if (distance < minDistance)\n                {\n                    minDistance = distance;\n                    nearest = enemy.transform;\n                }\n            }\n        }\n\n        return nearest;\n    }\n\n    /// <summary>\n    /// Khóa aim vào mục tiêu\n    /// </summary>\n    public void LockAimToTarget(Transform target)\n    {\n        if (target == null || !aimConfig.enableAutoAim) return;\n        if (playerCamera == null) return;\n\n        Vector3 directionToTarget = (target.position - playerCamera.transform.position).normalized;\n        Quaternion targetRotation = Quaternion.LookRotation(directionToTarget);\n\n        playerCamera.transform.rotation = Quaternion.Lerp(\n            playerCamera.transform.rotation,\n            targetRotation,\n            aimConfig.autoAimSnapSpeed * Time.deltaTime\n        );\n    }\n\n    /// <summary>\n    /// Tăng độ nhạy kéo màn hình 80%\n    /// </summary>\n    public void HandleAiming(float mouseX, float mouseY)\n    {\n        if (playerCamera == null) return;\n\n        // Áp dụng độ nhạy +80%\n        float adjustedMouseX = mouseX * aimConfig.mouseSensitivity;\n        float adjustedMouseY = mouseY * aimConfig.aimDownSightSensitivity;\n\n        playerCamera.transform.parent.Rotate(Vector3.up * adjustedMouseX);\n        playerCamera.transform.Rotate(Vector3.left * adjustedMouseY);\n    }\n\n    /// <summary>\n    /// Lấy thông tin cấu hình\n    /// </summary>\n    public void PrintConfigInfo()\n    {\n        Debug.Log($\"\"\"\n╔═════════════════════════════════════╗\n║     AIM LOCK V2 - OPTIMIZED         ║\n╠═════════════════════════════════════╣\n║ Device: {aimConfig.deviceProfile,-28}║\n║ Mouse Sensitivity: {aimConfig.mouseSensitivity,5:F1}x (±80%){\" \",-10}║\n║ Target FPS: {performanceConfig.targetFPS,-25}║\n║ Quality Level: {performanceConfig.qualityLevel,-22}║\n║ Vibration: {(vibrationConfig.enableVibration ? \"BẬT\" : \"TẮT\"),-26}║\n║ Shadow Distance: {performanceConfig.shadowDistance,-20}║\n║ Max Particles: {performanceConfig.maxParticles,-23}║\n║ Auto Aim: {(aimConfig.enableAutoAim ? \"BẬT\" : \"TẮT\"),-25}║\n║ Aim Assist: {(aimConfig.enableAimAssist ? \"BẬT\" : \"TẮT\"),-22}║\n║ Dynamic Resolution: {(graphicsSettings.enableDynamicResolution ? \"BẬT\" : \"TẮT\"),-15}║\n╚═════════════════════════════════════╝\n        \"\"\");\n    }\n\n    /// <summary>\n    /// Lấy mức độ lag hiện tại\n    /// </summary>\n    public bool IsCurrentlyLagging() => isLagging;\n\n    /// <summary>\n    /// Bật/Tắt rung\n    /// </summary>\n    public void SetVibrationEnabled(bool enabled)\n    {\n        vibrationConfig.enableVibration = enabled;\n    }\n\n    /// <summary>\n    /// Lấy độ nhạy hiện tại\n    /// </summary>\n    public float GetMouseSensitivity()\n    {\n        return aimConfig.mouseSensitivity;\n    }\n\n    /// <summary>\n    /// Lấy FPS target\n    /// </summary>\n    public int GetTargetFPS()\n    {\n        return performanceConfig.targetFPS;\n    }\n\n    public static AimLockV2 Instance => instance;\n    public OptimizedAimConfig Aim => aimConfig;\n    public OptimizedPerformanceConfig Performance => performanceConfig;\n    public OptimizedVibrationConfig Vibration => vibrationConfig;\n}\n