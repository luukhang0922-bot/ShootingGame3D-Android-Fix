using UnityEngine;\nusing System.Collections.Generic;\n\n/// <summary>\n/// AimLockV1.crt - Chứng chỉ cấu hình AI & Aiming Lock\n/// Cài đặt độ nhạy aim, mục tiêu khóa, và AI thông minh cho game bắn súng 3D\n/// Format: .crt (Certificate Configuration File)\n/// </summary>\npublic class AimLockV1 : MonoBehaviour\n{\n    private static AimLockV1 instance;\n\n    [System.Serializable]\n    public class AimConfig\n    {\n        public string configName = \"Default\";\n        public float mouseSensitivity = 2f;\n        public float aimDownSightSensitivity = 1f;\n        public bool enableAutoAim = false;\n        public float autoAimRange = 50f;\n        public float autoAimSnapSpeed = 5f;\n        public bool enableAimAssist = true;\n        public float aimAssistRadius = 1.5f;\n        public float aimAssistStrength = 0.8f;\n        public bool enableRecoilCompensation = true;\n        public float recoilAmount = 0.5f;\n        public float recoilRecoverySpeed = 2f;\n    }\n\n    [System.Serializable]\n    public class AIConfig\n    {\n        public string aiLevel = \"Easy\"; // Easy, Normal, Hard\n        public float aiReactionTime = 0.5f; // Thời gian phản ứng của AI (giây)\n        public float aiAimAccuracy = 0.7f; // Độ chính xác (0-1)\n        public float aiDetectionRange = 30f; // Tầm phát hiện\n        public float aiShootingCooldown = 0.15f; // Thời gian giữa các phát bắn\n        public bool enableAIPrediction = true; // AI dự đoán vị trí mục tiêu\n        public float aiPredictionAccuracy = 0.6f; // Độ chính xác dự đoán\n        public bool enableAIPatrolling = true; // AI tuần tra\n        public float aiPatrolSpeed = 2f;\n    }\n\n    [System.Serializable]\n    public class PerformanceConfig\n    {\n        public int targetFPS = 60;\n        public bool useFixedTimeStep = true;\n        public float fixedDeltaTime = 0.0167f;\n        public int raycastPoolSize = 100;\n        public bool enableObjectPooling = true;\n        public int bulletPoolSize = 200;\n    }\n\n    [System.Serializable]\n    public class CertificateData\n    {\n        public string certificateName = \"AimLockV1\";\n        public string version = \"1.0.0\";\n        public string issueDate = \"2026-09-04\";\n        public string expiryDate = \"2099-12-31\";\n        public string signature = \"AIMLOCKV1_CERT_AUTH\";\n        public bool isValid = true;\n    }\n\n    [SerializeField] private CertificateData certificateData = new CertificateData();\n    [SerializeField] private AimConfig aimConfig = new AimConfig();\n    [SerializeField] private AIConfig aiConfig = new AIConfig();\n    [SerializeField] private PerformanceConfig performanceConfig = new PerformanceConfig();\n\n    private Camera playerCamera;\n    private Rigidbody playerRigidbody;\n    private float recoilRotationX = 0f;\n    private float recoilRotationY = 0f;\n    private List<GameObject> bulletPool = new List<GameObject>();\n\n    void Awake()\n    {\n        if (instance == null)\n        {\n            instance = this;\n            DontDestroyOnLoad(gameObject);\n            VerifyCertificate();\n            InitializeConfig();\n        }\n        else\n        {\n            Destroy(gameObject);\n        }\n    }\n\n    void Start()\n    {\n        playerCamera = Camera.main;\n        playerRigidbody = GetComponent<Rigidbody>();\n        ApplyAimSettings();\n        ApplyAISettings();\n        ApplyPerformanceSettings();\n    }\n\n    void Update()\n    {\n        if (playerCamera == null) return;\n        \n        HandleAiming();\n        HandleRecoil();\n    }\n\n    /// <summary>\n    /// Xác minh chứng chỉ cấu hình\n    /// </summary>\n    bool VerifyCertificate()\n    {\n        if (!certificateData.isValid)\n        {\n            Debug.LogError(\"[AimLockV1] Chứng chỉ không hợp lệ!\");\n            return false;\n        }\n\n        System.DateTime expiryDateTime;\n        if (System.DateTime.TryParse(certificateData.expiryDate, out expiryDateTime))\n        {\n            if (System.DateTime.Now > expiryDateTime)\n            {\n                Debug.LogError($\"[AimLockV1] Chứng chỉ đã hết hạn vào {certificateData.expiryDate}\");\n                return false;\n            }\n        }\n\n        Debug.Log($\"[AimLockV1] ✓ Chứng chỉ xác thực thành công\\n\" +\n                  $\"Tên: {certificateData.certificateName}\\n\" +\n                  $\"Phiên bản: {certificateData.version}\\n\" +\n                  $\"Chữ ký: {certificateData.signature}\");\n        return true;\n    }\n\n    /// <summary>\n    /// Khởi tạo cấu hình mặc định\n    /// </summary>\n    void InitializeConfig()\n    {\n        // Cấu hình aim mặc định\n        if (aimConfig == null)\n        {\n            aimConfig = new AimConfig\n            {\n                configName = \"Default Aim\",\n                mouseSensitivity = 2f,\n                aimDownSightSensitivity = 1f,\n                enableAutoAim = false,\n                autoAimRange = 50f,\n                autoAimSnapSpeed = 5f,\n                enableAimAssist = true,\n                aimAssistRadius = 1.5f,\n                aimAssistStrength = 0.8f,\n                enableRecoilCompensation = true,\n                recoilAmount = 0.5f,\n                recoilRecoverySpeed = 2f\n            };\n        }\n\n        // Cấu hình AI mặc định\n        if (aiConfig == null)\n        {\n            aiConfig = new AIConfig\n            {\n                aiLevel = \"Normal\",\n                aiReactionTime = 0.5f,\n                aiAimAccuracy = 0.7f,\n                aiDetectionRange = 30f,\n                aiShootingCooldown = 0.15f,\n                enableAIPrediction = true,\n                aiPredictionAccuracy = 0.6f,\n                enableAIPatrolling = true,\n                aiPatrolSpeed = 2f\n            };\n        }\n    }\n\n    /// <summary>\n    /// Áp dụng cài đặt aim\n    /// </summary>\n    void ApplyAimSettings()\n    {\n        Debug.Log($\"[AimLock] Áp dụng cài đặt aim: {aimConfig.configName}\");\n        Debug.Log($\"Độ nhạy: {aimConfig.mouseSensitivity}x\");\n        Debug.Log($\"Auto Aim: {(aimConfig.enableAutoAim ? \"BẬT\" : \"TẮT\")}\");\n        Debug.Log($\"Aim Assist: {(aimConfig.enableAimAssist ? \"BẬT\" : \"TẮT\")}\");\n    }\n\n    /// <summary>\n    /// Áp dụng cài đặt AI\n    /// </summary>\n    void ApplyAISettings()\n    {\n        Debug.Log($\"[AI] Áp dụng cài đặt AI: {aiConfig.aiLevel}\");\n        Debug.Log($\"Thời gian phản ứng: {aiConfig.aiReactionTime}s\");\n        Debug.Log($\"Độ chính xác: {aiConfig.aiAimAccuracy * 100}%\");\n        Debug.Log($\"Tầm phát hiện: {aiConfig.aiDetectionRange}m\");\n    }\n\n    /// <summary>\n    /// Áp dụng cài đặt hiệu năng\n    /// </summary>\n    void ApplyPerformanceSettings()\n    {\n        QualitySettings.targetFrameRate = performanceConfig.targetFPS;\n        Time.fixedDeltaTime = performanceConfig.fixedDeltaTime;\n        Debug.Log($\"[Performance] FPS: {performanceConfig.targetFPS} | FixedDeltaTime: {performanceConfig.fixedDeltaTime}\");\n    }\n\n    /// <summary>\n    /// Xử lý aim (nhắm bắn)\n    /// </summary>\n    void HandleAiming()\n    {\n        if (playerCamera == null) return;\n\n        float mouseX = Input.GetAxis(\"Mouse X\") * aimConfig.mouseSensitivity;\n        float mouseY = Input.GetAxis(\"Mouse Y\") * aimConfig.mouseSensitivity;\n\n        // Áp dụng độ nhạy khác khi bắn\n        if (Input.GetMouseButton(1)) // Right-click = ADS\n        {\n            mouseX *= aimConfig.aimDownSightSensitivity;\n            mouseY *= aimConfig.aimDownSightSensitivity;\n        }\n\n        // Áp dụng Aim Assist\n        if (aimConfig.enableAimAssist)\n        {\n            AdjustAimAssist(ref mouseX, ref mouseY);\n        }\n\n        // Xoay camera\n        playerCamera.transform.parent.Rotate(Vector3.up * mouseX);\n        playerCamera.transform.Rotate(Vector3.left * mouseY);\n    }\n\n    /// <summary>\n    /// Hỗ trợ aim (pull towards targets)\n    /// </summary>\n    void AdjustAimAssist(ref float mouseX, ref float mouseY)\n    {\n        Collider[] colliders = Physics.OverlapSphere(playerCamera.transform.position,\n            aimConfig.aimAssistRadius);\n\n        foreach (Collider col in colliders)\n        {\n            if (col.CompareTag(\"Enemy\"))\n            {\n                Vector3 toTarget = col.transform.position - playerCamera.transform.position;\n                Vector3 forward = playerCamera.transform.forward;\n\n                float angle = Vector3.Angle(forward, toTarget);\n                if (angle < aimConfig.aimAssistRadius)\n                {\n                    // Điều chỉnh aim về phía mục tiêu\n                    mouseX += toTarget.x * aimConfig.aimAssistStrength * Time.deltaTime;\n                    mouseY -= toTarget.y * aimConfig.aimAssistStrength * Time.deltaTime;\n                }\n            }\n        }\n    }\n\n    /// <summary>\n    /// Xử lý recoil (giật súng)\n    /// </summary>\n    void HandleRecoil()\n    {\n        if (!aimConfig.enableRecoilCompensation) return;\n\n        // Giảm recoil dần dần\n        recoilRotationX = Mathf.Lerp(recoilRotationX, 0f, \n            aimConfig.recoilRecoverySpeed * Time.deltaTime);\n        recoilRotationY = Mathf.Lerp(recoilRotationY, 0f, \n            aimConfig.recoilRecoverySpeed * Time.deltaTime);\n    }\n\n    /// <summary>\n    /// Thêm recoil khi bắn\n    /// </summary>\n    public void ApplyRecoil()\n    {\n        if (!aimConfig.enableRecoilCompensation) return;\n\n        recoilRotationX += Random.Range(-aimConfig.recoilAmount, -aimConfig.recoilAmount * 0.5f);\n        recoilRotationY += Random.Range(-aimConfig.recoilAmount * 0.3f, aimConfig.recoilAmount * 0.3f);\n\n        Debug.Log($\"[Recoil] Recoil applied: X={recoilRotationX}, Y={recoilRotationY}\");\n    }\n\n    /// <summary>\n    /// Tìm mục tiêu gần nhất cho Auto Aim\n    /// </summary>\n    public Transform FindNearestTarget()\n    {\n        if (!aimConfig.enableAutoAim) return null;\n\n        Collider[] enemies = Physics.OverlapSphere(transform.position, \n            aimConfig.autoAimRange);\n        Transform nearest = null;\n        float minDistance = aimConfig.autoAimRange;\n\n        foreach (Collider enemy in enemies)\n        {\n            if (enemy.CompareTag(\"Enemy\"))\n            {\n                float distance = Vector3.Distance(transform.position, enemy.transform.position);\n                if (distance < minDistance)\n                {\n                    minDistance = distance;\n                    nearest = enemy.transform;\n                }\n            }\n        }\n\n        return nearest;\n    }\n\n    /// <summary>\n    /// Khóa aim vào mục tiêu\n    /// </summary>\n    public void LockAimToTarget(Transform target)\n    {\n        if (target == null || !aimConfig.enableAutoAim) return;\n\n        Vector3 directionToTarget = (target.position - playerCamera.transform.position).normalized;\n        Quaternion targetRotation = Quaternion.LookRotation(directionToTarget);\n\n        playerCamera.transform.rotation = Quaternion.Lerp(\n            playerCamera.transform.rotation,\n            targetRotation,\n            aimConfig.autoAimSnapSpeed * Time.deltaTime\n        );\n    }\n\n    /// <summary>\n    /// Lấy cấu hình AI dựa trên độ khó\n    /// </summary>\n    public AIConfig GetAIConfigByDifficulty(string difficulty)\n    {\n        AIConfig config = new AIConfig();\n\n        switch (difficulty.ToLower())\n        {\n            case \"easy\":\n                config.aiLevel = \"Easy\";\n                config.aiReactionTime = 1f;\n                config.aiAimAccuracy = 0.4f;\n                config.aiDetectionRange = 20f;\n                config.aiShootingCooldown = 0.25f;\n                config.aiPredictionAccuracy = 0.3f;\n                break;\n\n            case \"normal\":\n                config.aiLevel = \"Normal\";\n                config.aiReactionTime = 0.5f;\n                config.aiAimAccuracy = 0.7f;\n                config.aiDetectionRange = 30f;\n                config.aiShootingCooldown = 0.15f;\n                config.aiPredictionAccuracy = 0.6f;\n                break;\n\n            case \"hard\":\n                config.aiLevel = \"Hard\";\n                config.aiReactionTime = 0.2f;\n                config.aiAimAccuracy = 0.95f;\n                config.aiDetectionRange = 50f;\n                config.aiShootingCooldown = 0.08f;\n                config.aiPredictionAccuracy = 0.9f;\n                break;\n        }\n\n        return config;\n    }\n\n    /// <summary>\n    /// Cấu hình aim tùy chỉnh\n    /// </summary>\n    public void SetCustomAimConfig(string configName, float sensitivity, float assistRadius, float assistStrength)\n    {\n        aimConfig.configName = configName;\n        aimConfig.mouseSensitivity = sensitivity;\n        aimConfig.aimAssistRadius = assistRadius;\n        aimConfig.aimAssistStrength = assistStrength;\n        Debug.Log($\"[AimLock] Cấu hình tùy chỉnh: {configName}\");\n    }\n\n    /// <summary>\n    /// Bật/Tắt Auto Aim\n    /// </summary>\n    public void SetAutoAimEnabled(bool enabled)\n    {\n        aimConfig.enableAutoAim = enabled;\n        Debug.Log($\"[AimLock] Auto Aim: {(enabled ? \"BẬT\" : \"TẮT\")}\");\n    }\n\n    /// <summary>\n    /// Bật/Tắt Aim Assist\n    /// </summary>\n    public void SetAimAssistEnabled(bool enabled)\n    {\n        aimConfig.enableAimAssist = enabled;\n        Debug.Log($\"[AimLock] Aim Assist: {(enabled ? \"BẬT\" : \"TẮT\")}\");\n    }\n\n    /// <summary>\n    /// In thông tin chứng chỉ\n    /// </summary>\n    public void PrintCertificateInfo()\n    {\n        Debug.Log($\"\"\"\n╔═══════════════════════════════════╗\n║        AIM LOCK CERTIFICATE V1    ║\n╠═══════════════════════════════════╣\n║ Tên: {certificateData.certificateName,-28}║\n║ Phiên bản: {certificateData.version,-24}║\n║ Ngày phát hành: {certificateData.issueDate,-20}║\n║ Ngày hết hạn: {certificateData.expiryDate,-21}║\n║ Chữ ký: {certificateData.signature,-26}║\n║ Trạng thái: {(certificateData.isValid ? \"✓ Hợp lệ\" : \"✗ Không hợp lệ\"),-20}║\n╠═══════════════════════════════════╣\n║ AIM CONFIG                         ║\n║ Độ nhạy: {aimConfig.mouseSensitivity,-28}║\n║ Auto Aim: {(aimConfig.enableAutoAim ? \"BẬT\" : \"TẮT\"),-27}║\n║ Aim Assist: {(aimConfig.enableAimAssist ? \"BẬT\" : \"TẮT\"),-23}║\n╠═══════════════════════════════════╣\n║ AI CONFIG                          ║\n║ Độ khó: {aiConfig.aiLevel,-28}║\n║ Độ chính xác: {aiConfig.aiAimAccuracy * 100,5}%{\" \",-21}║\n║ Tầm phát hiện: {aiConfig.aiDetectionRange,-20}║\n╚═══════════════════════════════════╝\n        \"\"\");\n    }\n\n    /// <summary>\n    /// Lấy thông tin recoil hiện tại\n    /// </summary>\n    public Vector2 GetCurrentRecoil()\n    {\n        return new Vector2(recoilRotationX, recoilRotationY);\n    }\n\n    /// <summary>\n    /// Đặt lại recoil\n    /// </summary>\n    public void ResetRecoil()\n    {\n        recoilRotationX = 0f;\n        recoilRotationY = 0f;\n    }\n\n    // Properties\n    public static AimLockV1 Instance => instance;\n    public AimConfig Aim => aimConfig;\n    public AIConfig AI => aiConfig;\n    public PerformanceConfig Performance => performanceConfig;\n    public CertificateData Certificate => certificateData;\n}\n