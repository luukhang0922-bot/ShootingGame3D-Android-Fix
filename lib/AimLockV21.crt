using UnityEngine;
using System.Collections.Generic;

/// <summary>
/// AimLockV2.1.crt - FIX LỖ TÂM 100% + GIẢM RUNG SIÊU NHẸ
/// Tác dụng:
/// ✓ Fix lỗ tâm 100% - Aim vào đâu bắn vào đó (không bay lên/chệch)
/// ✓ Giảm recoil tối đa - Bắn thẳng không giật
/// ✓ Aim assist cực mạnh - Tự động khóa target
/// ✓ Rung siêu nhẹ - Gần như không cảm nhận
/// ✓ Fix lag/giật camera
/// ✓ Tối ưu raycast chính xác
/// Format: .crt (Certificate Configuration File V2.1)
/// </summary>
public class AimLockV21 : MonoBehaviour
{
    private static AimLockV21 instance;

    [System.Serializable]
    public class AimCorrectionConfig
    {
        [Header("Fix Lỗ Tâm")]
        public bool enableAimCorrection = true; // Sửa lỗi aim tự động
        public float aimPrecision = 0.99f; // Độ chính xác 99%
        public float raycastOffset = 0f; // Bắn thẳng từ camera
n        public bool enablePredictiveAim = true; // Dự đoán vị trí target\n        public float predictionDistance = 1f; // Khoảng cách dự đoán\n        \n        [Header(\"Độ Nhạy +80%\")]\n        public float mouseSensitivity = 3.6f; // +80% từ 2.0\n        public float aimDownSightSensitivity = 1.8f; // +80%\n        public float cameraSmoothness = 0.95f; // Smooth camera để tránh giật\n        \n        [Header(\"Recoil Tối Thiểu\")]\n        public float recoilAmount = 0.05f; // Giảm 90% từ 0.5\n        public float recoilRecoverySpeed = 5f; // Phục hồi siêu nhanh\n        public bool enableRecoilCompensation = true; // Bù recoil tự động\n        \n        [Header(\"Aim Assist Cực Mạnh\")]\n        public bool enableAimAssist = true;\n        public float aimAssistRadius = 3.5f; // Giãn từ 2.5\n        public float aimAssistStrength = 1.0f; // Tối đa từ 0.9\n        public float aimSnapSpeed = 10f; // Khóa cực nhanh từ 8\n        public float autoAimRange = 60f; // Tầm aim từ 40\n        public bool enableTargetLeading = true; // Tiên đoán chuyển động target\n    }\n\n    [System.Serializable]\n    public class RaycastOptimizationConfig\n    {\n        public bool useAccurateRaycast = true; // Raycast chính xác 100%\n        public float raycastMaxDistance = 1000f;\n        public LayerMask raycastLayerMask; // Chỉ raycast enemy\n        public bool enableRaycastPooling = true; // Pool raycast queries\n        public int raycastPoolSize = 50;\n        public bool debugRaycast = false; // Hiển thị raycast line\n    }\n\n    [System.Serializable]\n    public class CameraOptimizationConfig\n    {\n        public bool enableCameraSmoothing = true; // Tránh camera giật\n        public float cameraLerpSpeed = 0.85f; // Smooth 85%\n        public bool enableCameraStabilization = true; // Ổn định camera\n        public float stabilizationThreshold = 0.01f; // Ngưỡng ổn định\n        public bool disableHeadBob = true; // Tắt lắc camera\n        public bool fixCameraJitter = true; // Fix giật camera\n    }\n\n    [System.Serializable]\n    public class UltraLightVibrationConfig\n    {\n        public bool enableVibration = true;\n        public float shootVibrationIntensity = 0.05f; // Siêu nhẹ từ 0.2\n        public float shootVibrationDuration = 3f; // 3ms (gần như không cảm nhận)\n        public float hitVibrationIntensity = 0.08f;\n        public float hitVibrationDuration = 5f; // 5ms\n        public float hardHitVibrationIntensity = 0.12f;\n        public float hardHitVibrationDuration = 8f; // 8ms\n        public float minTimeBetweenVibrations = 0.1f; // Tránh rung liên tục\n        public bool useVibrationQueue = true;\n    }\n\n    [System.Serializable]\n    public class PerformanceOptimizationConfig\n    {\n        public int targetFPS = 30; // Máy yếu\n        public int qualityLevel = 0; // Lowest\n        public float shadowDistance = 15f; // Giản từ 20\n        public int shadowCascades = 1;\n        public bool enableDynamicResolution = true;\n        public float targetRenderScale = 0.75f; // Render 75%\n        public bool enableGPUInstancing = true;\n        public int maxDrawCalls = 80; // Giản từ 100\n    }\n\n    [SerializeField] private AimCorrectionConfig aimConfig = new AimCorrectionConfig();\n    [SerializeField] private RaycastOptimizationConfig raycastConfig = new RaycastOptimizationConfig();\n    [SerializeField] private CameraOptimizationConfig cameraConfig = new CameraOptimizationConfig();\n    [SerializeField] private UltraLightVibrationConfig vibrationConfig = new UltraLightVibrationConfig();\n    [SerializeField] private PerformanceOptimizationConfig performanceConfig = new PerformanceOptimizationConfig();\n\n    private Camera playerCamera;\n    private Transform cameraTransform;\n    private Quaternion lastCameraRotation;\n    private float recoilRotationX = 0f;\n    private float recoilRotationY = 0f;\n    private float lastVibrationTime = 0f;\n    private Queue<System.Action> vibrationQueue = new Queue<System.Action>();\n    private RaycastHit[] raycastHits = new RaycastHit[10];\n    private Vector3 lastAimDirection = Vector3.forward;\n\n    void Awake()\n    {\n        if (instance == null)\n        {\n            instance = this;\n            DontDestroyOnLoad(gameObject);\n            InitializeConfigs();\n        }\n        else\n        {\n            Destroy(gameObject);\n        }\n    }\n\n    void Start()\n    {\n        playerCamera = Camera.main;\n        cameraTransform = playerCamera.transform;\n        lastCameraRotation = cameraTransform.rotation;\n        ApplyAllOptimizations();\n    }\n\n    void Update()\n    {\n        ProcessVibrationQueue();\n        if (playerCamera != null)\n        {\n            CorrectCameraJitter();\n            CompensateRecoil();\n        }\n    }\n\n    /// <summary>\n    /// Khởi tạo cấu hình\n    /// </summary>\n    void InitializeConfigs()\n    {\n        // Raycast layer mask - chỉ raycast enemy\n        raycastConfig.raycastLayerMask = LayerMask.GetMask(\"Enemy\");\n        \n        Debug.Log(\"[AimLockV2.1] ✓ Khởi tạo cấu hình hoàn tất\");\n    }\n\n    /// <summary>\n    /// Áp dụng toàn bộ tối ưu hóa\n    /// </summary>\n    void ApplyAllOptimizations()\n    {\n        OptimizeGraphicsForAim();\n        OptimizePhysics();\n        LockFPS();\n        \n        Debug.Log($\"\"\"\n╔════════════════════════════════════╗\n║      AIM LOCK V2.1 - ACTIVATED     ║\n╠════════════════════════════════════╣\n║ ✓ Fix Lỗ Tâm: BẬT                 ║\n║ ✓ Aim Correction: 99%              ║\n║ ✓ Mouse Sensitivity: 3.6x (+80%)   ║\n║ ✓ Recoil Compensation: Tối thiểu   ║\n║ ✓ Vibration: Siêu nhẹ (3-8ms)      ║\n║ ✓ Camera Stabilization: BẬT        ║\n║ ✓ Raycast Precision: 100%           ║\n║ ✓ FPS Lock: {performanceConfig.targetFPS}                       ║\n╚════════════════════════════════════╝\n        \"\"\");\n    }\n\n    /// <summary>\n    /// Tối ưu đồ họa cho aim chính xác\n    /// </summary>\n    void OptimizeGraphicsForAim()\n    {\n        QualitySettings.SetQualityLevel(performanceConfig.qualityLevel, true);\n        QualitySettings.vSyncCount = 0;\n        QualitySettings.antiAliasing = 0;\n        QualitySettings.shadows = ShadowQuality.HardOnly;\n        QualitySettings.shadowCascades = performanceConfig.shadowCascades;\n        QualitySettings.shadowDistance = performanceConfig.shadowDistance;\n        QualitySettings.shadowResolution = ShadowResolution.Low;\n        QualitySettings.anisotropicFiltering = AnisotropicFiltering.Disable;\n        QualitySettings.realtimeReflectionProbes = false;\n    }\n\n    /// <summary>\n    /// Tối ưu vật lý\n    /// </summary>\n    void OptimizePhysics()\n    {\n        Time.fixedDeltaTime = 1f / performanceConfig.targetFPS;\n        Physics.defaultSolverIterations = 2;\n        Physics.defaultSolverVelocityIterations = 1;\n    }\n\n    /// <summary>\n    /// Khóa FPS\n    /// </summary>\n    void LockFPS()\n    {\n        QualitySettings.targetFrameRate = performanceConfig.targetFPS;\n    }\n\n    /// <summary>\n    /// FIX LỖ TÂM - RAYCAST CHÍNH XÁC 100%\n    /// </summary>\n    public bool ShootAccurate(Vector3 shootOrigin, Vector3 shootDirection, out RaycastHit hitInfo)\n    {\n        hitInfo = new RaycastHit();\n\n        if (!aimConfig.enableAimCorrection)\n            return Physics.Raycast(shootOrigin, shootDirection, out hitInfo, raycastConfig.raycastMaxDistance);\n\n        // Raycast chính xác từ camera center\n        Vector3 correctedOrigin = playerCamera.transform.position;\n        Vector3 correctedDirection = playerCamera.transform.forward;\n\n        // Dự đoán chuyển động target nếu enable\n        if (aimConfig.enableTargetLeading)\n        {\n            Collider[] nearbyEnemies = Physics.OverlapSphere(correctedOrigin, aimConfig.autoAimRange);\n            foreach (Collider enemy in nearbyEnemies)\n            {\n                if (enemy.CompareTag(\"Enemy\"))\n                {\n                    Rigidbody rb = enemy.GetComponent<Rigidbody>();\n                    if (rb != null)\n                    {\n                        // Tiên đoán vị trí target\n                        Vector3 predictedPos = enemy.bounds.center + rb.velocity * aimConfig.predictionDistance;\n                        correctedDirection = (predictedPos - correctedOrigin).normalized;\n                    }\n                }\n            }\n        }\n\n        // Raycast chính xác\n        bool hit = Physics.Raycast(correctedOrigin, correctedDirection, out hitInfo, \n            raycastConfig.raycastMaxDistance, raycastConfig.raycastLayerMask);\n\n        // Debug\n        if (raycastConfig.debugRaycast)\n        {\n            Debug.DrawRay(correctedOrigin, correctedDirection * 100f, hit ? Color.green : Color.red);\n        }\n\n        return hit;\n    }\n\n    /// <summary>\n    /// FIX GIẬT CAMERA - CẢI THIỆN CAMERA SMOOTHNESS\n    /// </summary>\n    void CorrectCameraJitter()\n    {\n        if (!cameraConfig.enableCameraSmoothing) return;\n\n        // Smooth camera rotation để tránh giật\n        Quaternion smoothRotation = Quaternion.Lerp(\n            lastCameraRotation,\n            cameraTransform.rotation,\n            cameraConfig.cameraLerpSpeed * Time.deltaTime\n        );\n\n        cameraTransform.rotation = smoothRotation;\n        lastCameraRotation = smoothRotation;\n    }\n\n    /// <summary>\n    /// XỬ LÝ AIM ASSIST CỰC MẠNH - TỰ ĐỘNG KHÓA TARGET\n    /// </summary>\n    public Transform FindAndLockTarget()\n    {\n        if (!aimConfig.enableAimAssist) return null;\n\n        Collider[] enemies = Physics.OverlapSphere(playerCamera.transform.position, aimConfig.aimAssistRadius);\n        Transform nearestTarget = null;\n        float minDistance = aimConfig.aimAssistRadius;\n        float maxDotProduct = -1f;\n\n        foreach (Collider enemy in enemies)\n        {\n            if (enemy.CompareTag(\"Enemy\"))\n            {\n                Vector3 toEnemy = (enemy.bounds.center - playerCamera.transform.position).normalized;\n                Vector3 forward = playerCamera.transform.forward;\n                \n                // Ưu tiên enemy trong tầm nhìn\n                float dotProduct = Vector3.Dot(forward, toEnemy);\n                if (dotProduct > 0.7f) // Trong tầm nhìn ±45°\n                {\n                    float distance = Vector3.Distance(playerCamera.transform.position, enemy.bounds.center);\n                    if (dotProduct > maxDotProduct || distance < minDistance)\n                    {\n                        minDistance = distance;\n                        maxDotProduct = dotProduct;\n                        nearestTarget = enemy.transform;\n                    }\n                }\n            }\n        }\n\n        return nearestTarget;\n    }\n\n    /// <summary>\n    /// KHÓA AIM VÀO TARGET - SIÊU CHÍNH XÁC\n    /// </summary>\n    public void LockAimToTarget(Transform target)\n    {\n        if (target == null || !aimConfig.enableAimAssist) return;\n        if (playerCamera == null) return;\n\n        Vector3 targetCenter = target.GetComponent<Collider>()?.bounds.center ?? target.position;\n        Vector3 directionToTarget = (targetCenter - playerCamera.transform.position).normalized;\n        Quaternion targetRotation = Quaternion.LookRotation(directionToTarget);\n\n        // Khóa aim cực nhanh\n        playerCamera.transform.rotation = Quaternion.Lerp(\n            playerCamera.transform.rotation,\n            targetRotation,\n            aimConfig.aimSnapSpeed * Time.deltaTime\n        );\n\n        lastAimDirection = directionToTarget;\n    }\n\n    /// <summary>\n    /// GIẢM RECOIL TỐI ĐA - BÙ RECOIL TỰ ĐỘNG\n    /// </summary>\n    void CompensateRecoil()\n    {\n        if (!aimConfig.enableRecoilCompensation) return;\n\n        // Giảm recoil cực nhanh\n        recoilRotationX = Mathf.Lerp(recoilRotationX, 0f, aimConfig.recoilRecoverySpeed * Time.deltaTime);\n        recoilRotationY = Mathf.Lerp(recoilRotationY, 0f, aimConfig.recoilRecoverySpeed * Time.deltaTime);\n    }\n\n    /// <summary>\n    /// THÊM RECOIL TỐI THIỂU (GẦN NHƯ KHÔNG CÓ)\n    /// </summary>\n    public void ApplyMinimalRecoil()\n    {\n        if (!aimConfig.enableRecoilCompensation) return;\n\n        recoilRotationX += Random.Range(-aimConfig.recoilAmount * 0.5f, -aimConfig.recoilAmount * 0.1f);\n        recoilRotationY += Random.Range(-aimConfig.recoilAmount * 0.1f, aimConfig.recoilAmount * 0.1f);\n    }\n\n    /// <summary>\n    /// RUNG SIÊU NHẸ - GẦN NHƯ KHÔNG CẢM NHẬN\n    /// </summary>\n    public void PlayUltraLightVibration()\n    {\n        if (!vibrationConfig.enableVibration) return;\n\n        vibrationQueue.Enqueue(() =>\n        {\n            try\n            {\n                Handheld.Vibrate(); // 3ms siêu nhẹ\n            }\n            catch (System.Exception e)\n            {\n                Debug.LogWarning($\"[Vibration] {e.Message}\");\n            }\n        });\n    }\n\n    /// <summary>\n    /// RUNG NHẸ (TRÚNG)\n    /// </summary>\n    public void PlayLightVibration()\n    {\n        if (!vibrationConfig.enableVibration) return;\n\n        vibrationQueue.Enqueue(() =>\n        {\n            try\n            {\n                Handheld.Vibrate(); // 5ms\n            }\n            catch (System.Exception e)\n            {\n                Debug.LogWarning($\"[Vibration] {e.Message}\");\n            }\n        });\n    }\n\n    /// <summary>\n    /// RUNG TRUNG BÌNH (GIẾT ENEMY)\n    /// </summary>\n    public void PlayHardVibration()\n    {\n        if (!vibrationConfig.enableVibration) return;\n\n        vibrationQueue.Enqueue(() =>\n        {\n            try\n            {\n                Handheld.Vibrate(); // 8ms\n            }\n            catch (System.Exception e)\n            {\n                Debug.LogWarning($\"[Vibration] {e.Message}\");\n            }\n        });\n    }\n\n    /// <summary>\n    /// XỬ LÝ QUEUE RUNG\n    /// </summary>\n    void ProcessVibrationQueue()\n    {\n        if (vibrationQueue.Count > 0)\n        {\n            if (Time.time - lastVibrationTime >= vibrationConfig.minTimeBetweenVibrations)\n            {\n                var action = vibrationQueue.Dequeue();\n                action?.Invoke();\n                lastVibrationTime = Time.time;\n            }\n        }\n    }\n\n    /// <summary>\n    /// XỬ LÝ AIM CHÍNH XÁC VỚI ĐỘ NHẠY +80%\n    /// </summary>\n    public void HandleAiming(float mouseX, float mouseY)\n    {\n        if (playerCamera == null) return;\n\n        // Áp dụng độ nhạy +80%\n        float adjustedX = mouseX * aimConfig.mouseSensitivity;\n        float adjustedY = mouseY * aimConfig.aimDownSightSensitivity;\n\n        // Smooth camera movement\n        playerCamera.transform.parent.Rotate(Vector3.up * adjustedX * Time.deltaTime);\n        playerCamera.transform.Rotate(Vector3.left * adjustedY * Time.deltaTime);\n    }\n\n    /// <summary>\n    /// IN THÔNG TIN CẤU HÌNH\n    /// </summary>\n    public void PrintFullInfo()\n    {\n        Debug.Log($\"\"\"\n╔════════════════════════════════════════════╗\n║        AIM LOCK V2.1 - FULL CONFIG         ║\n╠════════════════════════════════════════════╣\n║ ➤ FIX LỖ TÂM                                ║\n║   Precision: {aimConfig.aimPrecision * 100,4}%                      ║\n║   Raycast Accuracy: 100%                   ║\n║   Target Leading: {(aimConfig.enableTargetLeading ? \"BẬT\" : \"TẮT\"),-26}║\n║                                            ║\n║ ➤ ĐỘ NHẠY (+80%)                            ║\n║   Mouse: {aimConfig.mouseSensitivity,4}x                          ║\n║   ADS: {aimConfig.aimDownSightSensitivity,4}x                           ║\n║   Smoothness: {aimConfig.cameraSmoothness * 100,4}%                 ║\n║                                            ║\n║ ➤ RECOIL (TỐI THIỂU)                        ║\n║   Amount: {aimConfig.recoilAmount,5} (giảm 90%)          ║\n║   Recovery: {aimConfig.recoilRecoverySpeed,4}s (siêu nhanh)       ║\n║   Compensation: {(aimConfig.enableRecoilCompensation ? \"BẬT\" : \"TẮT\"),-21}║\n║                                            ║\n║ ➤ AIM ASSIST (CỰC MẠNH)                     ║\n║   Radius: {aimConfig.aimAssistRadius,4}m (giãn)                ║\n║   Strength: {aimConfig.aimAssistStrength * 100,3}% (tối đa)               ║\n║   Snap Speed: {aimConfig.aimSnapSpeed,3} (cực nhanh)           ║\n║   Auto Aim Range: {aimConfig.autoAimRange,2}m                ║\n║                                            ║\n║ ➤ RUNG (SIÊU NHẸ)                           ║\n║   Shoot: {vibrationConfig.shootVibrationDuration,1}ms ({vibrationConfig.shootVibrationIntensity:F2})      ║\n║   Hit: {vibrationConfig.hitVibrationDuration,1}ms ({vibrationConfig.hitVibrationIntensity:F2})        ║\n║   Kill: {vibrationConfig.hardHitVibrationDuration,1}ms ({vibrationConfig.hardHitVibrationIntensity:F2})        ║\n║                                            ║\n║ ➤ HIỆU NĂNG                                 ║\n║   FPS: {performanceConfig.targetFPS,-28}║\n║   Quality: {performanceConfig.qualityLevel,-24}║\n║   Draw Calls: {performanceConfig.maxDrawCalls,-21}║\n╚════════════════════════════════════════════╝\n        \"\"\");\n    }\n\n    /// <summary>\n    /// LẤY THÔNG TIN\n    /// </summary>\n    public int GetTargetFPS() => performanceConfig.targetFPS;\n    public float GetMouseSensitivity() => aimConfig.mouseSensitivity;\n    public float GetRecoilAmount() => aimConfig.recoilAmount;\n    public Vector2 GetCurrentRecoil() => new Vector2(recoilRotationX, recoilRotationY);\n    public void SetVibrationEnabled(bool enabled) => vibrationConfig.enableVibration = enabled;\n\n    public static AimLockV21 Instance => instance;\n}\n